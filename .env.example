# CryptoTop Environment Variables Example Template
# Copy this file to .env and fill in your actual credentials

ADMIN_SECRET_KEY=your_super_secret_admin_key_here
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_personal_telegram_chat_id
PORT=8080

# Vault Address Pools (Comma-separated addresses)
TRC20_WALLET_ADDRESSES=your_trc20_address_1,your_trc20_address_2
BEP20_WALLET_ADDRESSES=your_bep20_address_1,your_bep20_address_2
